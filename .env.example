# BloomLens — Environment Variables
# Copy this file to .env and fill in your values.
#
#   cp .env.example .env        (Linux / macOS)
#   copy .env.example .env      (Windows)

# ── Groq API ───────────────────────────────────────────────────────────────
# Required for Tab 3 (cloud translation) and Tab 4 (generative AI).
# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# ── LLM Provider ───────────────────────────────────────────────────────────
# Which provider to use for LLM calls.
# Options: groq | openai | mock
# "mock" disables real API calls and returns placeholder responses (useful for testing).
LLM_PROVIDER=groq

# ── Demo Mode ──────────────────────────────────────────────────────────────
# Set to true to skip API calls and use cached/static responses throughout.
# Useful for running the app offline or in a demo environment.
DEMO_MODE=false
